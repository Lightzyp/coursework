<h3>Items</h3>

@page "/items"
@using GameManual.Models
@inject GameManual.Services.ItemService ItemService

<h2>Items</h2>

@if (_loading)
{
    <p>Loading…</p>
}
else if (_error is not null)
{

    <div class="alert alert-danger">@_error</div>
}
else
{
    <div class="row">
        @foreach (var i in _items)
        {
            <div class="col-4 mb-3">
                <div class="card" style="width:18rem;">
                    <img src="@i.ImageUrl" class="card-img-top" alt="@i.Name" />
                    <div class="card-body">
                        <h5 class="card-title">@i.Name</h5>
                        <p class="card-text">@i.Description</p>
                        <a href="/item/@i.Id" class="btn btn-primary">Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private bool _loading = true;
    private string? _error;
    private IReadOnlyList<Item> _items = Array.Empty<Item>();

    protected override async Task OnInitializedAsync()
    {
        try { _items = await ItemService.GetAllAsync(30); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
}


