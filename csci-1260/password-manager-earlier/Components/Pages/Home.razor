@page "/"
@rendermode InteractiveServer
@inject Project_4.Services.PasswordManagerService PasswordService

<h1>Welcome to Your Password Manager</h1>

<div class="alert alert-info mt-4">
    <h5><strong>Where Your Passwords Are Stored</strong></h5>
    <p>Your saved passwords are securely stored on your computer at:</p>

    <div class="p-2 bg-light border rounded">
        <code>@PasswordService.FileLocation</code>
    </div>

    <button class="btn btn-primary mt-2" @onclick="OpenFolder">
        Open Password Folder
    </button>
    
    <p class="mt-3">
        You can open this folder any time to back up, copy, or manage your password file.
    </p>
</div>

@code {
    private void OpenFolder()
    {
        PasswordService.OpenPasswordFolder();
    }
}
