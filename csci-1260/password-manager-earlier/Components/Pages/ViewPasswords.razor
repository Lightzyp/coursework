@page "/view"
@rendermode InteractiveServer
@inject Project_4.Services.PasswordManagerService PasswordService
@using Project_4.Models

<h3>Saved Passwords</h3>

<div class="text-muted mb-2" style="font-size: 0.9rem;">
    Password file stored at: <em>@PasswordService.FileLocation</em>
</div>

<button class="btn btn-outline-secondary btn-sm me-2" @onclick="OpenFolder">
    Open Password Folder
</button>

<button class="btn btn-outline-success btn-sm" @onclick="BackupFile">
    Backup to Desktop
</button>

<hr />

<!-- SEARCH BAR -->
<div class="mb-3">
    <input class="form-control" placeholder="Search..." @bind="searchTerm" />
</div>

@if (!FilteredPasswords.Any())
{
    <p>No passwords match your search.</p>
}
else
{
    <table class="table table-modern w-100">


        <thead>
            <tr>
                <th>Site</th>
                <th>Username</th>
                <th>Password</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var entry in FilteredPasswords)
            {
                <tr>
                    <td>@entry.Site</td>
                    <td>@entry.Username</td>

                    <td>
                        @if (showPasswords.Contains(entry.Site))
                        {
                            <span>@entry.Password</span>
                            <button class="btn btn-sm btn-outline-secondary ms-2"
                                    @onclick="() => TogglePassword(entry.Site)">
                                Hide
                            </button>
                        }
                        else
                        {
                            <span>********</span>
                            <button class="btn btn-sm btn-outline-secondary ms-2"
                                    @onclick="() => TogglePassword(entry.Site)">
                                Show
                            </button>
                        }
                    </td>

                    <td>
                        <button class="btn btn-warning btn-sm me-2"
                                @onclick="() => StartEdit(entry)">
                            Edit
                        </button>

                        <button class="btn btn-danger btn-sm"
                                @onclick="() => DeleteEntry(entry.Site)">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- EDIT POPUP CARD -->
@if (editingEntry != null)
{
    var strength = GetPasswordStrength(editingEntry.Password);
    var strengthColor = GetStrengthColor(strength);

    <div class="card p-3 mt-3" style="max-width: 480px;">
        <h5>Edit Password</h5>

        <div class="mb-2">
            <label>Site</label>
            <input class="form-control" @bind="editingEntry.Site" disabled />
        </div>

        <div class="mb-2">
            <label>Username</label>
            <input class="form-control" @bind="editingEntry.Username" />
        </div>

        <div class="mb-2">
            <label>Password</label>

            <div class="input-group">
                <input class="form-control"
                       @bind="editingEntry.Password"
                       @bind:event="oninput" />

                <button class="btn btn-outline-success btn-sm"
                        type="button"
                        @onclick="GenerateNewPasswordForEdit">
                    Generate New
                </button>
            </div>

            <div class="mt-1" style="font-weight:bold; color:@strengthColor;">
                Strength: @strength
            </div>
        </div>

        <button class="btn btn-success me-2" @onclick="SaveEdit">
            Save Changes
        </button>

        <button class="btn btn-secondary" @onclick="CancelEdit">
            Cancel
        </button>
    </div>
}

@code {

    private HashSet<string> showPasswords = new();
    private string searchTerm = "";
    private PasswordEntry? editingEntry = null;

    // Filter passwords based on search term
    private IEnumerable<PasswordEntry> FilteredPasswords =>
        PasswordService.GetAll()
        .Where(p =>
            string.IsNullOrWhiteSpace(searchTerm) ||
            p.Site.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            p.Username.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
        );

    // Toggle password visibility for a specific site
    private void TogglePassword(string site)
    {
        if (showPasswords.Contains(site))
            showPasswords.Remove(site);
        else
            showPasswords.Add(site);
    }

    private void DeleteEntry(string site)
    {
        PasswordService.Remove(site);
    }

    // Start editing a password entry
    private void StartEdit(PasswordEntry entry)
    {
        // Make a copy so we don't edit the list directly until Save
        editingEntry = new PasswordEntry(entry.Site, entry.Username, entry.Password);
    }

    private void SaveEdit()
    {
        if (editingEntry != null)
        {
            PasswordService.Update(editingEntry);
            editingEntry = null;
        }
    }

    private void CancelEdit()
    {
        editingEntry = null;
    }

    private void OpenFolder()
    {
        PasswordService.OpenPasswordFolder();
    }

    private void BackupFile()
    {
        PasswordService.BackupToDesktop();
    }

    // Generate a strong random password for the edit modal
    private void GenerateNewPasswordForEdit()
    {
        if (editingEntry is null)
            return;

        var chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@$?_-#%";
        var random = new Random();

        editingEntry.Password = new string(
            Enumerable.Repeat(chars, 16)
                      .Select(s => s[random.Next(s.Length)])
                      .ToArray()
        );
    }

    // PASSWORD STRENGTH FUNCTIONS
    private string GetPasswordStrength(string password)
    {
        if (string.IsNullOrWhiteSpace(password))
            return "Weak";

        int score = 0;

        if (password.Length >= 8)
            score++;
        if (password.Any(char.IsUpper))
            score++;
        if (password.Any(char.IsLower))
            score++;
        if (password.Any(char.IsDigit))
            score++;
        if (password.Any(ch => "!@#$%^&*()_+-=[]{}|;:'\",.<>?".Contains(ch)))
            score++;

        return score switch
        {
            <= 2 => "Weak",
            3 => "Medium",
            _ => "Strong"
        };
    }

    private string GetStrengthColor(string strength) =>
        strength switch
        {
            "Weak" => "red",
            "Medium" => "orange",
            "Strong" => "green",
            _ => "red"
        };
}
