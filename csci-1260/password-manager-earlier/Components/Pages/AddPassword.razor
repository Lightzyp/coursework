@page "/add"
@rendermode InteractiveServer
@using Project_4.Models
@inject Project_4.Services.PasswordManagerService PasswordService

<h3>Add Password</h3>

<!-- SUBTLE REMINDER -->
<div class="text-muted mb-2" style="font-size: 0.9rem;">
    Password file stored at: <em>@PasswordService.FileLocation</em>
</div>

<button class="btn btn-outline-secondary btn-sm mb-3" @onclick="OpenFolder">
    Open Password Folder
</button>

@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert alert-success">@Message</div>
}
@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}

<div class="mb-3">
    <label class="form-label">Site</label>
    <input class="form-control" @bind="site" />
</div>

<div class="mb-3">
    <label class="form-label">Username</label>
    <input class="form-control" @bind="username" />
</div>

<div class="mb-3">
    <label class="form-label">Password</label>

    <!-- PASSWORD INPUT + GENERATOR + SHOW/HIDE BUTTON -->
    <div class="input-group">
        <input class="form-control"
               type="@(_showPassword ? "text" : "password")"
               @bind="password"
               @oninput="CheckStrength"
               placeholder="Password" />

        <button class="btn btn-outline-secondary" @onclick="TogglePassword">
            <i class="bi @( _showPassword ? "bi-eye-slash" : "bi-eye")"></i>
        </button>

        <button class="btn btn-outline-success" @onclick="GeneratePassword">
            <i class="bi bi-shield-lock"></i> Generate
        </button>
    </div>

    <div class="mt-1">
        <span>Password Strength: </span>
        <strong style="color:@strengthColor">@passwordStrength</strong>
    </div>
</div>

<button class="btn btn-primary" @onclick="Save">Save</button>
<a class="btn btn-link ms-2" href="/view">View Saved Passwords</a>

@code {
    private string site = "";
    private string username = "";
    private string password = "";

    private string? Message;
    private string? ErrorMessage;

    private bool _showPassword = false;
    private string passwordStrength = "Weak";
    private string strengthColor = "red";

    // Open the folder where passwords are stored
    private void OpenFolder()
    {
        PasswordService.OpenPasswordFolder();
    }

    private void TogglePassword() => _showPassword = !_showPassword;

    private void GeneratePassword()
    {
        var chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@$?_-#%";
        var random = new Random();
        password = new string(Enumerable.Repeat(chars, 16)
            .Select(s => s[random.Next(s.Length)]).ToArray());

        CheckStrength();
    }

    // Check the strength of the password
    private void CheckStrength(ChangeEventArgs? e = null)
    {
        if (!string.IsNullOrEmpty(e?.Value?.ToString()))
            password = e.Value!.ToString()!;

        int score = 0;

        if (password.Length >= 8) score++;
        if (password.Any(char.IsUpper)) score++;
        if (password.Any(char.IsLower)) score++;
        if (password.Any(char.IsDigit)) score++;
        if (password.Any(c => "!@#$%^&*()_+=-{}[]|:;'<>,.?/".Contains(c))) score++;

        switch (score)
        {
            case <= 2:
                passwordStrength = "Weak";
                strengthColor = "red";
                break;

            case 3:
                passwordStrength = "Medium";
                strengthColor = "orange";
                break;

            default:
                passwordStrength = "Strong";
                strengthColor = "green";
                break;
        }
    }

    // Save the new password entry
    private void Save()
    {
        ErrorMessage = null;
        Message = null;

        try
        {
            if (string.IsNullOrWhiteSpace(site))
            {
                ErrorMessage = "Site is required.";
                return;
            }

            PasswordService.AddOrUpdate(new PasswordEntry(site, username, password));

            if (!string.IsNullOrEmpty(PasswordService.LastError))
            {
                ErrorMessage = PasswordService.LastError;
                return;
            }

            Message = $"Saved password for '{site}'.";
            site = "";
            username = "";
            password = "";
            passwordStrength = "Weak";
            strengthColor = "red";
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Unexpected error: {ex.Message}";
        }
    }
}
