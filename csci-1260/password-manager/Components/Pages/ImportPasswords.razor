@page "/import"
@rendermode InteractiveServer
@using Project_4.Services
@inject Project_4.Services.PasswordManagerService PasswordService
@inject NavigationManager Navigation

<PageTitle>Import from Chrome | Vaultly</PageTitle>

@if (PasswordService.IsUnlocked)
{
    <section class="page-heading">
        <div>
            <span class="eyebrow">Chrome import</span>
            <h1>Bring your Chrome passwords into Vaultly</h1>
            <p>Export your passwords from Chrome, select the CSV here, and Vaultly will immediately encrypt the imported credentials into your local vault.</p>
        </div>
        <a class="btn btn-outline-secondary" href="/view"><i class="bi bi-arrow-left"></i> Back to vault</a>
    </section>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="notice success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@successMessage</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="notice danger">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span>@errorMessage</span>
        </div>
    }

    <section class="import-layout">
        <article class="panel import-panel">
            <span class="eyebrow">Step 1</span>
            <h2>Export your Chrome passwords</h2>
            <p>In Chrome, open Google Password Manager, choose <strong>Settings</strong>, then choose <strong>Download file</strong> under Export passwords. Chrome may ask you to confirm your identity.</p>
            <a class="btn btn-light" href="https://passwords.google.com/options" target="_blank" rel="noopener noreferrer">
                <i class="bi bi-box-arrow-up-right"></i> Open Google Password Manager
            </a>
        </article>

        <article class="panel import-panel">
            <span class="eyebrow">Step 2</span>
            <h2>Select the exported CSV</h2>
            <p>The CSV is read into memory only long enough to encrypt the imported entries. Vaultly does not copy or retain the plaintext export file.</p>

            <label class="file-drop" for="chrome-password-csv">
                <i class="bi bi-file-earmark-arrow-up"></i>
                <strong>@(string.IsNullOrEmpty(selectedFileName) ? "Choose Chrome password CSV" : selectedFileName)</strong>
                <span>Maximum file size: 5 MB</span>
            </label>
            <InputFile id="chrome-password-csv"
                       class="visually-hidden"
                       accept=".csv,text/csv"
                       OnChange="PreviewFileAsync" />

            @if (preview != null)
            {
                <div class="import-preview">
                    <div>
                        <strong>@preview.Entries.Count</strong>
                        <span>passwords ready to encrypt</span>
                    </div>
                    <div>
                        <strong>@preview.SkippedRows</strong>
                        <span>empty rows skipped</span>
                    </div>
                </div>
                <p class="privacy-note"><i class="bi bi-eye-slash-fill"></i> Password values are intentionally hidden from this preview.</p>
            }
        </article>

        <article class="panel import-panel import-confirm">
            <span class="eyebrow">Step 3</span>
            <h2>Encrypt and store</h2>
            <p>Vaultly preserves every import row. If Chrome contains multiple logins for the same site, the additional entries receive a clear username-based label.</p>
            <button class="btn btn-primary"
                    @onclick="EncryptAndImportPasswords"
                    disabled="@(preview == null)">
                <i class="bi bi-shield-lock-fill"></i>
                Import @(preview?.Entries.Count ?? 0) passwords
            </button>
        </article>
    </section>

    <section class="notice warning import-warning">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div>
            <strong>Delete the Chrome CSV after importing.</strong>
            <span>The exported file contains readable passwords. Empty your Recycle Bin after deleting it, then run Vaultly's leak scan from My vault.</span>
        </div>
    </section>
}

@code {
    private const long MaxCsvSize = 5 * 1024 * 1024;

    private ChromePasswordImportPreview? preview;
    private string? selectedFileName;
    private string? successMessage;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        if (!PasswordService.IsUnlocked)
            Navigation.NavigateTo("/login");
    }

    private async Task PreviewFileAsync(InputFileChangeEventArgs args)
    {
        preview = null;
        selectedFileName = null;
        successMessage = null;
        errorMessage = null;

        try
        {
            var file = args.File;
            selectedFileName = file.Name;

            await using var stream = file.OpenReadStream(MaxCsvSize);
            using var reader = new StreamReader(stream);
            var csv = await reader.ReadToEndAsync();

            preview = ChromePasswordCsvImporter.Parse(csv);
        }
        catch (IOException)
        {
            errorMessage = "The CSV is too large. Export a file smaller than 5 MB.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void EncryptAndImportPasswords()
    {
        if (preview == null)
            return;

        errorMessage = null;
        successMessage = null;

        var result = PasswordService.ImportEntries(preview.Entries);
        if (!string.IsNullOrEmpty(PasswordService.LastError))
        {
            errorMessage = PasswordService.LastError;
            return;
        }

        successMessage = $"{result.Imported} passwords encrypted and imported. " +
            $"{result.Renamed} duplicate-site labels were adjusted. " +
            "Delete the plaintext Chrome CSV now, then open My vault to scan for leaked passwords.";

        preview = null;
        selectedFileName = null;
    }
}
