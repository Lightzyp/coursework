@page "/view"
@rendermode InteractiveServer
@using Project_4.Models
@inject Project_4.Services.PasswordManagerService PasswordService
@inject Project_4.Services.PwnedPasswordService PwnedPasswordService
@inject NavigationManager Navigation

<PageTitle>My Vault | Vaultly</PageTitle>

@if (PasswordService.IsUnlocked)
{
    <section class="page-heading">
        <div>
            <span class="eyebrow">My vault</span>
            <h1>Saved passwords</h1>
            <p>Review your encrypted credentials and check for passwords that appear in known leak data.</p>
        </div>
        <div class="heading-actions">
            <a class="btn btn-outline-secondary" href="/import"><i class="bi bi-browser-chrome"></i> Import Chrome</a>
            <button class="btn btn-outline-secondary" @onclick="BackupFile"><i class="bi bi-download"></i> Backup</button>
            <a class="btn btn-primary" href="/add"><i class="bi bi-plus-lg"></i> Add password</a>
        </div>
    </section>

    @if (!string.IsNullOrEmpty(actionMessage))
    {
        <div class="notice success"><i class="bi bi-check-circle-fill"></i><span>@actionMessage</span></div>
    }
    @if (!string.IsNullOrEmpty(actionError))
    {
        <div class="notice danger"><i class="bi bi-exclamation-circle-fill"></i><span>@actionError</span></div>
    }

    <section class="panel breach-panel">
        <div class="breach-copy">
            <div class="breach-icon"><i class="bi bi-shield-exclamation"></i></div>
            <div>
                <span class="eyebrow">Leak monitor</span>
                <h2>Check your saved passwords</h2>
                <p>Vaultly checks each password locally and sends only a five-character SHA-1 prefix to the Pwned Passwords range API. A match means the password appeared in known leak data, not necessarily that this specific account was breached.</p>
                <a href="https://haveibeenpwned.com/Passwords" target="_blank" rel="noopener noreferrer">Learn about Pwned Passwords <i class="bi bi-box-arrow-up-right"></i></a>
            </div>
        </div>
        <button class="btn btn-dark" @onclick="ScanVaultAsync" disabled="@isScanning">
            @if (isScanning)
            {
                <span class="spinner-border spinner-border-sm"></span>
                <span>Scanning @scannedCount of @scanTotal</span>
            }
            else
            {
                <i class="bi bi-radar"></i>
                <span>Scan vault</span>
            }
        </button>
    </section>

    @if (scanResults.Count > 0)
    {
        <section class="scan-summary @(ExposedCount > 0 ? "has-exposure" : "all-clear")">
            <i class="bi @(ExposedCount > 0 ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")"></i>
            <div>
                @if (ExposedCount > 0)
                {
                    <strong>@ExposedCount saved @(ExposedCount == 1 ? "password appears" : "passwords appear") in known leak data.</strong>
                    <span>Replace exposed passwords with newly generated ones as soon as possible.</span>
                }
                else
                {
                    <strong>No scanned passwords were found in the known leak data.</strong>
                    <span>Keep using unique passwords and scan again after adding new credentials.</span>
                }
            </div>
        </section>
    }

    <section class="vault-toolbar">
        <label class="search-box">
            <i class="bi bi-search"></i>
            <input type="search" placeholder="Search by site or username" @bind="searchTerm" @bind:event="oninput" />
        </label>
        <span>@FilteredPasswords.Count() saved @(FilteredPasswords.Count() == 1 ? "login" : "logins")</span>
    </section>

    @if (!FilteredPasswords.Any())
    {
        <section class="empty-state panel">
            <div class="empty-icon"><i class="bi bi-key"></i></div>
            <h2>No passwords found</h2>
            <p>@(string.IsNullOrWhiteSpace(searchTerm) ? "Add your first credential to start building your vault." : "Try a different site name or username.")</p>
            @if (string.IsNullOrWhiteSpace(searchTerm))
            {
                <a class="btn btn-primary" href="/add"><i class="bi bi-plus-lg"></i> Add your first password</a>
            }
        </section>
    }
    else
    {
        <section class="credential-list">
            @foreach (var entry in FilteredPasswords)
            {
                <article class="credential-card">
                    <div class="credential-main">
                        <span class="site-avatar">@GetInitial(entry.Site)</span>
                        <div class="credential-identity">
                            <strong>@entry.Site</strong>
                            <span>@(string.IsNullOrWhiteSpace(entry.Username) ? "No username saved" : entry.Username)</span>
                        </div>
                    </div>

                    <div class="credential-secret">
                        <code>@(showPasswords.Contains(entry.Site) ? entry.Password : "••••••••••••")</code>
                        <button class="icon-button compact" type="button" @onclick="() => TogglePassword(entry.Site)" title="Show or hide password">
                            <i class="bi @(showPasswords.Contains(entry.Site) ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>

                    <div class="credential-health">
                        @if (scanResults.TryGetValue(entry.Site, out var result))
                        {
                            @if (!string.IsNullOrEmpty(result.Error))
                            {
                                <span class="health-badge unknown"><i class="bi bi-wifi-off"></i> Check failed</span>
                            }
                            else if (result.Count > 0)
                            {
                                <span class="health-badge exposed"><i class="bi bi-exclamation-triangle-fill"></i> Exposed @result.Count.ToString("N0")x</span>
                            }
                            else
                            {
                                <span class="health-badge clear"><i class="bi bi-check-circle-fill"></i> Not found</span>
                            }
                        }
                        else
                        {
                            <button class="health-badge unscanned" @onclick="() => CheckPasswordAsync(entry)" disabled="@isScanning">
                                <i class="bi bi-search"></i> Check exposure
                            </button>
                        }
                    </div>

                    <div class="credential-actions">
                        <button class="icon-button compact" type="button" @onclick="() => StartEdit(entry)" title="Edit credential">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="icon-button compact danger" type="button" @onclick="() => RequestDelete(entry.Site)" title="Delete credential">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </div>
                </article>

                @if (pendingDeleteSite == entry.Site)
                {
                    <div class="delete-confirm">
                        <span>Delete <strong>@entry.Site</strong> from your vault?</span>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteEntry(entry.Site)">Delete</button>
                        <button class="btn btn-light btn-sm" @onclick="CancelDelete">Cancel</button>
                    </div>
                }
            }
        </section>
    }

    @if (editingEntry != null)
    {
        <section class="edit-overlay">
            <article class="panel edit-card">
                <div class="panel-heading">
                    <div>
                        <span class="eyebrow">Edit credential</span>
                        <h2>@editingEntry.Site</h2>
                    </div>
                    <button class="icon-button" type="button" @onclick="CancelEdit" title="Close editor"><i class="bi bi-x-lg"></i></button>
                </div>

                <div class="field-group">
                    <label>Username or email</label>
                    <input class="form-control" @bind="editingEntry.Username" @bind:event="oninput" />
                </div>

                <div class="field-group">
                    <label>Password</label>
                    <div class="input-with-actions">
                        <input class="form-control" type="text" @bind="editingEntry.Password" @bind:event="oninput" />
                        <button class="btn btn-outline-primary generate-button" type="button" @onclick="GenerateNewPasswordForEdit">
                            <i class="bi bi-stars"></i> Generate
                        </button>
                    </div>
                </div>

                <div class="field-group">
                    <label>Notes <small>Optional</small></label>
                    <textarea class="form-control" rows="3" @bind="editingEntry.Notes" @bind:event="oninput"></textarea>
                </div>

                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="SaveEdit">Save changes</button>
                    <button class="btn btn-light" @onclick="CancelEdit">Cancel</button>
                </div>
            </article>
        </section>
    }
}

@code {
    private readonly HashSet<string> showPasswords = new();
    private readonly Dictionary<string, ExposureResult> scanResults = new();
    private string searchTerm = "";
    private string? pendingDeleteSite;
    private string? actionMessage;
    private string? actionError;
    private PasswordEntry? editingEntry;
    private bool isScanning;
    private int scannedCount;
    private int scanTotal;

    private IEnumerable<PasswordEntry> FilteredPasswords =>
        PasswordService.GetAll()
            .Where(p =>
                string.IsNullOrWhiteSpace(searchTerm) ||
                p.Site.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                p.Username.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            .OrderBy(p => p.Site);

    private int ExposedCount => scanResults.Values.Count(result => result.Count > 0);

    protected override void OnInitialized()
    {
        if (!PasswordService.IsUnlocked)
            Navigation.NavigateTo("/login");
    }

    private static string GetInitial(string site) =>
        string.IsNullOrWhiteSpace(site) ? "?" : site[..1].ToUpperInvariant();

    private void TogglePassword(string site)
    {
        if (!showPasswords.Add(site))
            showPasswords.Remove(site);
    }

    private async Task CheckPasswordAsync(PasswordEntry entry)
    {
        try
        {
            scanResults[entry.Site] = new ExposureResult(await PwnedPasswordService.GetExposureCountAsync(entry.Password));
        }
        catch
        {
            scanResults[entry.Site] = new ExposureResult(0, "The leak check is temporarily unavailable.");
        }
    }

    private async Task ScanVaultAsync()
    {
        var entries = PasswordService.GetAll();
        scanResults.Clear();
        actionError = null;
        scannedCount = 0;
        scanTotal = entries.Count;
        isScanning = true;

        foreach (var entry in entries)
        {
            await CheckPasswordAsync(entry);
            scannedCount++;
            StateHasChanged();
        }

        isScanning = false;
    }

    private void RequestDelete(string site) => pendingDeleteSite = site;
    private void CancelDelete() => pendingDeleteSite = null;

    private void DeleteEntry(string site)
    {
        PasswordService.Remove(site);
        scanResults.Remove(site);
        showPasswords.Remove(site);
        pendingDeleteSite = null;
        actionError = PasswordService.LastError;
        actionMessage = string.IsNullOrEmpty(actionError) ? $"{site} was deleted from your vault." : null;
    }

    private void StartEdit(PasswordEntry entry)
    {
        editingEntry = new PasswordEntry(entry.Site, entry.Username, entry.Password, entry.Notes);
    }

    private void SaveEdit()
    {
        if (editingEntry == null)
            return;

        if (string.IsNullOrWhiteSpace(editingEntry.Password))
        {
            actionError = "Password cannot be empty.";
            return;
        }

        PasswordService.Update(editingEntry);
        actionError = PasswordService.LastError;

        if (string.IsNullOrEmpty(actionError))
        {
            scanResults.Remove(editingEntry.Site);
            actionMessage = $"{editingEntry.Site} was updated.";
            editingEntry = null;
        }
    }

    private void CancelEdit() => editingEntry = null;

    private void BackupFile()
    {
        PasswordService.BackupToDesktop();
        actionError = PasswordService.LastError;
        actionMessage = string.IsNullOrEmpty(actionError)
            ? "Encrypted backup saved to your desktop."
            : null;
    }

    private void GenerateNewPasswordForEdit()
    {
        if (editingEntry != null)
            editingEntry.Password = Project_4.Services.PasswordManagerService.GenerateSecurePassword(18, true);
    }

    private sealed record ExposureResult(int Count, string? Error = null);
}
