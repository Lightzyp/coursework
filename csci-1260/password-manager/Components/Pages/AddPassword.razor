@page "/add"
@rendermode InteractiveServer
@using Project_4.Models
@inject Project_4.Services.PasswordManagerService PasswordService
@inject Project_4.Services.PwnedPasswordService PwnedPasswordService
@inject NavigationManager Navigation

<PageTitle>Add Password | Vaultly</PageTitle>

@if (PasswordService.IsUnlocked)
{
    <section class="page-heading">
        <div>
            <span class="eyebrow">New credential</span>
            <h1>Add a password</h1>
            <p>Store a login in your encrypted vault and check whether its password has appeared in known leaks.</p>
        </div>
        <a class="btn btn-outline-secondary" href="/view"><i class="bi bi-arrow-left"></i> Back to vault</a>
    </section>

    <section class="form-shell">
        <article class="panel form-panel">
            @if (!string.IsNullOrEmpty(Message))
            {
                <div class="notice success"><i class="bi bi-check-circle-fill"></i><span>@Message</span></div>
            }
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="notice danger"><i class="bi bi-exclamation-circle-fill"></i><span>@ErrorMessage</span></div>
            }

            <div class="field-grid">
                <div class="field-group">
                    <label for="site">Site or service <span>*</span></label>
                    <input id="site" class="form-control" @bind="site" @bind:event="oninput" placeholder="Example: Gmail" />
                </div>

                <div class="field-group">
                    <label for="username">Username or email</label>
                    <input id="username" class="form-control" @bind="username" @bind:event="oninput" placeholder="[REDACTED EMAIL]" />
                </div>
            </div>

            <div class="field-group">
                <label for="password">Password <span>*</span></label>
                <div class="input-with-actions">
                    <input id="password"
                           class="form-control"
                           type="@(_showPassword ? "text" : "password")"
                           @bind="PasswordValue"
                           @bind:event="oninput"
                           placeholder="Enter or generate a password" />
                    <button class="icon-button" type="button" @onclick="TogglePassword" title="Show or hide password">
                        <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                    <button class="btn btn-outline-primary generate-button" type="button" @onclick="GeneratePassword">
                        <i class="bi bi-stars"></i> Generate
                    </button>
                </div>
                <div class="strength-summary">
                    <div class="strength-track"><span class="strength-fill @StrengthClass" style="width: @StrengthWidth%"></span></div>
                    <span class="@StrengthClass">@PasswordStrength</span>
                </div>
            </div>

            <div class="exposure-check">
                <div>
                    <strong><i class="bi bi-shield-exclamation"></i> Check against known leaks</strong>
                    <p>Only a five-character hash prefix is sent to the Pwned Passwords API. Your password stays private.</p>
                </div>
                <button class="btn btn-outline-secondary" type="button" @onclick="CheckExposureAsync" disabled="@isCheckingExposure">
                    @if (isCheckingExposure)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="bi bi-search"></i>
                    }
                    Check exposure
                </button>
            </div>

            @if (exposureCount.HasValue)
            {
                <div class="notice @(exposureCount > 0 ? "danger" : "success")">
                    <i class="bi @(exposureCount > 0 ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")"></i>
                    <span>@ExposureMessage</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(exposureError))
            {
                <div class="notice warning"><i class="bi bi-wifi-off"></i><span>@exposureError</span></div>
            }

            <div class="field-group">
                <label for="notes">Notes <small>Optional</small></label>
                <textarea id="notes" class="form-control" @bind="notes" @bind:event="oninput" rows="4" placeholder="Recovery details, account context, or a reminder"></textarea>
            </div>

            <div class="form-actions">
                <button class="btn btn-primary" @onclick="Save"><i class="bi bi-lock-fill"></i> Save to vault</button>
                <a class="btn btn-light" href="/view">Cancel</a>
            </div>
        </article>

        <aside class="panel tip-panel">
            <span class="eyebrow">Password health</span>
            <h2>Build a stronger login</h2>
            <p>Unique passwords matter more than clever patterns. A generated password is the easiest win.</p>
            <div class="tip-list">
                <span class="@TipClass(password.Length >= 12)"><i class="bi @TipIcon(password.Length >= 12)"></i> Use at least 12 characters</span>
                <span class="@TipClass(password.Any(char.IsUpper))"><i class="bi @TipIcon(password.Any(char.IsUpper))"></i> Include uppercase letters</span>
                <span class="@TipClass(password.Any(char.IsLower))"><i class="bi @TipIcon(password.Any(char.IsLower))"></i> Include lowercase letters</span>
                <span class="@TipClass(password.Any(char.IsDigit))"><i class="bi @TipIcon(password.Any(char.IsDigit))"></i> Include a number</span>
                <span class="@TipClass(HasSpecialChars(password))"><i class="bi @TipIcon(HasSpecialChars(password))"></i> Include a special character</span>
            </div>
        </aside>
    </section>
}

@code {
    private string site = "";
    private string username = "";
    private string password = "";
    private string notes = "";
    private string? Message;
    private string? ErrorMessage;
    private string? exposureError;
    private int? exposureCount;
    private bool isCheckingExposure;
    private bool _showPassword;

    private string PasswordValue
    {
        get => password;
        set
        {
            password = value;
            exposureCount = null;
            exposureError = null;
        }
    }

    private string PasswordStrength => GetPasswordStrength(password);
    private string StrengthClass => PasswordStrength.ToLowerInvariant();
    private int StrengthWidth => PasswordStrength switch
    {
        "Strong" => 100,
        "Medium" => 62,
        _ => string.IsNullOrEmpty(password) ? 0 : 30
    };
    private string ExposureMessage => exposureCount > 0
        ? $"This password appears {exposureCount:N0} times in known leak data. Do not use it."
        : "Good news: this password was not found in the known leak data.";

    protected override void OnInitialized()
    {
        if (!PasswordService.IsUnlocked)
            Navigation.NavigateTo("/login");
    }

    private void TogglePassword() => _showPassword = !_showPassword;

    private static bool HasSpecialChars(string text)
    {
        const string specialChars = "!@$%^&*()_+=-[]{}|;:,.<>?/";
        return text.Any(specialChars.Contains);
    }

    private static string GetPasswordStrength(string value)
    {
        var score = 0;
        if (value.Length >= 8) score++;
        if (value.Length >= 12) score++;
        if (value.Length >= 16) score++;
        if (value.Any(char.IsUpper)) score++;
        if (value.Any(char.IsLower)) score++;
        if (value.Any(char.IsDigit)) score++;
        if (HasSpecialChars(value)) score++;

        return score switch
        {
            <= 3 => "Weak",
            4 or 5 => "Medium",
            _ => "Strong"
        };
    }

    private static string TipClass(bool met) => met ? "met" : "";
    private static string TipIcon(bool met) => met ? "bi-check-circle-fill" : "bi-circle";

    private void GeneratePassword()
    {
        PasswordValue = Project_4.Services.PasswordManagerService.GenerateSecurePassword(18, true);
    }

    private async Task CheckExposureAsync()
    {
        exposureCount = null;
        exposureError = null;

        if (string.IsNullOrWhiteSpace(password))
        {
            exposureError = "Enter or generate a password before checking exposure.";
            return;
        }

        try
        {
            isCheckingExposure = true;
            exposureCount = await PwnedPasswordService.GetExposureCountAsync(password);
        }
        catch
        {
            exposureError = "The leak check is temporarily unavailable. You can still save the password.";
        }
        finally
        {
            isCheckingExposure = false;
        }
    }

    private void Save()
    {
        ErrorMessage = null;
        Message = null;

        if (string.IsNullOrWhiteSpace(site))
        {
            ErrorMessage = "Site name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(password))
        {
            ErrorMessage = "Password is required.";
            return;
        }

        if (PasswordStrength == "Weak")
        {
            ErrorMessage = "This password is weak. Please strengthen it or generate a new one.";
            return;
        }

        PasswordService.AddOrUpdate(new PasswordEntry(site.Trim(), username.Trim(), password, notes.Trim()));

        if (!string.IsNullOrEmpty(PasswordService.LastError))
        {
            ErrorMessage = PasswordService.LastError;
            return;
        }

        Message = $"Password saved for {site.Trim()}.";
        site = "";
        username = "";
        PasswordValue = "";
        notes = "";
    }
}
