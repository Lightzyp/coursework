@inherits LayoutComponentBase

<div class="page-shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="app-main">
        <div class="top-row px-4">
            <span class="top-status"><i class="bi bi-shield-check"></i> Local encrypted vault</span>
            <span class="top-meta">AES-256-GCM protected</span>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">&times;</a>
</div>
