@model ICollection<Patient>
@{
    ViewData["Title"] = "Patients";
}

<h1>Patients</h1>

@if (Model.Count == 0)
{
    <p>No patients yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Appointments</th>
                <th scope="col"><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var patient in Model)
            {
                <tr>
                    <td>@patient.Name</td>
                    <td>@patient.Appointments.Count</td>
                    <td>
                        <a asp-controller="Patients" asp-action="Details" asp-route-id="@patient.Id">Details</a> |
                        <a asp-controller="Appointment" asp-action="CreateForPatient" asp-route-id="@patient.Id">Schedule Appointment</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
