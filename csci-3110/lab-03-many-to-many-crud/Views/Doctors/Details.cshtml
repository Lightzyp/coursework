@model Doctor
@{
    ViewData["Title"] = Model.Name;
}

<h1>@Model.Name</h1>
<dl class="row">
    <dt class="col-sm-2">Specialty</dt>
    <dd class="col-sm-10">@(string.IsNullOrEmpty(Model.Specialty) ? "Not specified" : Model.Specialty)</dd>
</dl>

<h2 class="h4">Appointments</h2>
<p>
    <a class="btn btn-primary" asp-controller="Appointment" asp-action="CreateForDoctor" asp-route-id="@Model.Id">Schedule Appointment</a>
</p>

@if (Model.Appointments.Count == 0)
{
    <p>This doctor has no appointments yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col">Patient</th>
                <th scope="col">Date</th>
                <th scope="col">Notes</th>
                <th scope="col"><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var appointment in Model.Appointments.OrderBy(a => a.Date))
            {
                <tr>
                    <td>@appointment.Patient.Name</td>
                    <td>@appointment.Date.ToString("g")</td>
                    <td>@appointment.Notes</td>
                    <td>
                        <a asp-controller="Appointment" asp-action="Edit" asp-route-id="@appointment.Id" asp-route-from="Doctor">Edit</a> |
                        <a asp-controller="Appointment" asp-action="Delete" asp-route-id="@appointment.Id" asp-route-from="Doctor">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Doctors" asp-action="Index">Back to Doctors</a>
