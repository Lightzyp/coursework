@model ICollection<Doctor>
@{
    ViewData["Title"] = "Doctors";
}

<h1>Doctors</h1>

@if (Model.Count == 0)
{
    <p>No doctors yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Specialty</th>
                <th scope="col">Appointments</th>
                <th scope="col"><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var doctor in Model)
            {
                <tr>
                    <td>@doctor.Name</td>
                    <td>@doctor.Specialty</td>
                    <td>@doctor.Appointments.Count</td>
                    <td>
                        <a asp-controller="Doctors" asp-action="Details" asp-route-id="@doctor.Id">Details</a> |
                        <a asp-controller="Appointment" asp-action="CreateForDoctor" asp-route-id="@doctor.Id">Schedule Appointment</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
