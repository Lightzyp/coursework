@model Appointment
@{
    ViewData["Title"] = "Delete Appointment";
    var from = (string)ViewData["From"]!;
}

<h1>Delete Appointment</h1>
<p>Are you sure you want to delete this appointment? The doctor and the patient will not be deleted.</p>

<dl class="row">
    <dt class="col-sm-2">Doctor</dt>
    <dd class="col-sm-10">@Model.Doctor.Name</dd>
    <dt class="col-sm-2">Patient</dt>
    <dd class="col-sm-10">@Model.Patient.Name</dd>
    <dt class="col-sm-2">Date</dt>
    <dd class="col-sm-10">@Model.Date.ToString("g")</dd>
    <dt class="col-sm-2">Notes</dt>
    <dd class="col-sm-10">@Model.Notes</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" asp-route-from="@from" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    @if (from == "Doctor")
    {
        <a class="btn btn-link" asp-controller="Doctors" asp-action="Details" asp-route-id="@Model.DoctorId">Cancel</a>
    }
    else
    {
        <a class="btn btn-link" asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId">Cancel</a>
    }
</form>
