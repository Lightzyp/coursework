@page "/borrowreturn"
@rendermode InteractiveServer
@inject ILibraryService LibraryService

<PageTitle>Borrow / Return</PageTitle>

<h3>Borrow a Book</h3>

<div class="mb-3">
    <label>Select User:</label>
    <select class="form-select" @bind="selectedUserId">
        <option value="0">-- Select User --</option>
        @foreach (var user in users)
        {
            <option value="@user.Id">@user.Name</option>
        }
    </select>
</div>

<div class="mb-3">
    <label>Select Book:</label>
    <select class="form-select" @bind="selectedBookId">
        <option value="0">-- Select Book --</option>
        @foreach (var book in availableBooks)
        {
            <option value="@book.Id">@book.Title</option>
        }
    </select>
</div>

<button class="btn btn-primary" @onclick="BorrowBook">Borrow Book</button>

@if (!string.IsNullOrWhiteSpace(message))
{
    <p class="mt-3"><strong>@message</strong></p>
}

<hr />

<h3>Return a Book</h3>

<div class="mb-3">
    <label>Select User:</label>
    <select class="form-select" @bind="SelectedReturnUserId">
        <option value="0">-- Select User --</option>
        @foreach (var user in users)
        {
            <option value="@user.Id">@user.Name</option>
        }
    </select>
</div>

@if (borrowedBySelectedUser.Any())
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Book ID</th>
                <th>Title</th>
                <th>Return</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in borrowedBySelectedUser)
            {
                <tr>
                    <td>@book.Id</td>
                    <td>@book.Title</td>
                    <td>
                        <button class="btn btn-success btn-sm" @onclick="() => ReturnBook(book.Id)">
                            Return
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else if (returnUserId != 0)
{
    <p>No borrowed books for this user.</p>
}

@code {
    private List<User> users = new();
    private List<Book> books = new();
    private List<Book> availableBooks = new();
    private List<Book> borrowedBySelectedUser = new();

    private int selectedUserId;
    private int selectedBookId;
    private int returnUserId;
    private string message = "";

    private int SelectedReturnUserId
    {
        get => returnUserId;
        set
        {
            returnUserId = value;
            borrowedBySelectedUser = LibraryService.GetBorrowedBooksByUser(returnUserId);
        }
    }

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        users = LibraryService.GetUsers();
        books = LibraryService.GetBooks();
        availableBooks = books.Where(b => !LibraryService.IsBookBorrowed(b.Id)).ToList();
        borrowedBySelectedUser = LibraryService.GetBorrowedBooksByUser(returnUserId);
    }

    private void BorrowBook()
    {
        if (selectedUserId == 0 || selectedBookId == 0)
        {
            message = "Please select both a user and a book.";
            return;
        }

        bool success = LibraryService.BorrowBook(selectedUserId, selectedBookId);

        message = success ? "Book borrowed successfully." : "That book is already borrowed.";

        selectedUserId = 0;
        selectedBookId = 0;

        LoadData();
    }

    private void ReturnBook(int bookId)
    {
        bool success = LibraryService.ReturnBook(returnUserId, bookId);

        message = success ? "Book returned successfully." : "Could not return the book.";

        LoadData();
    }
}